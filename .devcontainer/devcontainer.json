{
  "name": "Ecommerce Data Pipeline",
  "build": { 
    "dockerfile": "Dockerfile" 
  },
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:1": {
      "version": "latest"
    }
  },
  "onCreateCommand": "sudo rm -f /etc/apt/sources.list.d/yarn.list && sudo apt-get update",
  "postStartCommand": "cd airflow && docker-compose --env-file ../.env up -d"
}